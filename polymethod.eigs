# ============================================================
# polymethod CLI — run the ladder rungs against their oracles
# ============================================================
#
#   eigenscript polymethod.eigs [n] [m_count] [seed] [k]     # rung 1 (default)
#   eigenscript polymethod.eigs max2sat [n] [m] [seed]       # rung 2, one size
#   eigenscript polymethod.eigs max2sat-sweep [seed]         # rung 2, n sweep
#
# Rung 1 (SYM∘AND): seeded circuit, zeta-transform engine vs direct brute
# force on all 2^n inputs. Rung 2 (split-and-list MAX-2-SAT): optimum via
# weight-split triangle search vs 2^n brute force, plus the certificate
# check; the sweep prints the measured cost curves (the crossover
# artifact). Run from the repo root (load paths are cwd-relative).

load_file of "lib/int_vector.eigs"
load_file of "src/symplus.eigs"
load_file of "src/split_list.eigs"
load_file of "src/restriction.eigs"
load_file of "src/ac0xor.eigs"
load_file of "src/thr2.eigs"

define run_ac0(n, circ, label, do_brute) as:
    local t0 is clock_unix of null
    local e is rt_count of [n, circ]
    local t1 is clock_unix of null
    local rt_ms is floor of ((t1 - t0) * 1000)
    local agree is "skipped"
    local brute_ms is 0 - 1
    if do_brute == 1:
        local b is brute_count of [n, circ]
        local t2 is clock_unix of null
        brute_ms is floor of ((t2 - t1) * 1000)
        agree is "0"
        if b == e.count:
            agree is "1"
    local size is bit_shl of [1, n]
    print of f"ac0 {label} n={n} count={e.count} agree={agree} leaves={e.leaves} full=2^{n}={size} rt_ms={rt_ms} brute_ms={brute_ms}"
    if do_brute == 1 and agree != "1":
        print of "FAIL: restriction tree disagrees with brute force"
        exit of 1

define run_max2sat(n, m_count, seed, do_brute) as:
    local clauses is gen_max2sat of [n, m_count, seed]
    local t0 is clock_unix of null
    local s is sl_max2sat of [n, clauses]
    local t1 is clock_unix of null
    local sl_ms is floor of ((t1 - t0) * 1000)
    local agree is "skipped"
    local brute_ms is 0 - 1
    if do_brute == 1:
        local b is brute_max2sat of [n, clauses]
        local t2 is clock_unix of null
        brute_ms is floor of ((t2 - t1) * 1000)
        agree is "0"
        if b == s.opt:
            agree is "1"
    print of f"max2sat n={n} m={m_count} seed={seed} opt={s.opt} certified={s.ok} agree={agree} table_entries={s.table_entries} word_ops={s.word_ops} sl_ms={sl_ms} brute_ms={brute_ms}"
    if s.ok != 1:
        print of "FAIL: certificate mismatch"
        exit of 1
    if do_brute == 1 and agree != "1":
        print of "FAIL: split-and-list disagrees with brute force"
        exit of 1

define main() as:
    local argv is args of null
    if (len of argv) > 0 and argv[0] == "max2sat":
        local n is 12
        local m_count is 36
        local seed is 1
        if (len of argv) > 1:
            n is num of argv[1]
        if (len of argv) > 2:
            m_count is num of argv[2]
        if (len of argv) > 3:
            seed is num of argv[3]
        run_max2sat of [n, m_count, seed, 1]
        return 0
    if (len of argv) > 0 and argv[0] == "max2sat-sweep":
        local seed is 1
        if (len of argv) > 1:
            seed is num of argv[1]
        for sweep_n in [9, 12, 15, 18, 21]:
            run_max2sat of [sweep_n, sweep_n * 3, seed, 1]
        return 0
    if (len of argv) > 0 and argv[0] == "ac0":
        local n is 14
        local m_count is 28
        local k is 3
        local seed is 1
        if (len of argv) > 1:
            n is num of argv[1]
        if (len of argv) > 2:
            m_count is num of argv[2]
        if (len of argv) > 3:
            k is num of argv[3]
        if (len of argv) > 4:
            seed is num of argv[4]
        run_ac0 of [n, gen_kcnf of [n, m_count, k, seed], f"{k}-cnf m={m_count} seed={seed}", 1]
        return 0
    if (len of argv) > 0 and argv[0] == "ac0-sweep":
        local seed is 1
        if (len of argv) > 1:
            seed is num of argv[1]
        # fan-in sweep: savings vs bottom fan-in k at fixed n (the
        # switching-lemma shape), oracle-checked at n=16
        for sweep_k in [2, 3, 4, 5]:
            run_ac0 of [16, gen_kcnf of [16, 32, sweep_k, seed], f"{sweep_k}-cnf m=32 seed={seed}", 1]
        run_ac0 of [16, gen_ac0_3 of [16, 8, 3, 3, seed], f"depth3 m=8 w=3 k=3 seed={seed}", 1]
        # scale showcase, engine only (brute unaffordable): n=24
        run_ac0 of [24, gen_kcnf of [24, 48, 3, seed], f"3-cnf m=48 seed={seed}", 0]
        return 0
    if (len of argv) > 0 and argv[0] == "ac0x-sweep":
        local seed is 11
        if (len of argv) > 1:
            seed is num of argv[1]
        # the pure Razborov unit: error vs t on one OR of 6 literals, n=8
        local or_circ is [2, [[0, 0, 1], [0, 1, 1], [0, 2, 1], [0, 3, 1], [0, 4, 1], [0, 5, 1]]]
        for t in [1, 2, 3, 4, 5, 6]:
            local tot is 0
            local mono is 0
            for sd in [1, 2, 3, 4, 5]:
                local s is ax_single of [8, or_circ, t, sd]
                tot is tot + s.mismatches
                if s.monomials > mono:
                    mono is s.monomials
            print of f"ac0x single-OR t={t} mean_mismatches={tot / 5} of 256 max_monomials={mono}"
        # composed depth-3 XOR∘AND∘OR at n=10: error vs t, then majority
        local circ is gen_ac0x of [10, 3, 2, 3, 5]
        local b is brute_count_x of [10, circ]
        for t in [2, 4, 6, 8]:
            local s is ax_single of [10, circ, t, seed]
            print of f"ac0x circuit t={t} count={s.count} brute={b} mismatches={s.mismatches} of 1024 monomials={s.monomials}"
        local mj is ax_majority of [10, circ, 8, 9, seed]
        local agree is "0"
        if mj.count == b:
            agree is "1"
        print of f"ac0x circuit t=8 r=9 majority count={mj.count} brute={b} agree={agree} mismatches={mj.mismatches}"
        if agree != "1":
            print of "FAIL: majority count disagrees with brute force"
            exit of 1
        return 0
    if (len of argv) > 0 and argv[0] == "thr2":
        local n is 12
        local m_count is 4
        local k is 5
        local seed is 1
        if (len of argv) > 1:
            n is num of argv[1]
        if (len of argv) > 2:
            m_count is num of argv[2]
        if (len of argv) > 3:
            k is num of argv[3]
        if (len of argv) > 4:
            seed is num of argv[4]
        local c is gen_thr2 of [n, m_count, k, seed]
        local b is brute_thr2 of c
        local s is t2_single of [c, k, m_count, 7]
        local agree is "0"
        if s.count == b and s.mismatches == 0:
            agree is "1"
        print of f"thr2 n={n} m={m_count} k={k} seed={seed} count={s.count} brute={b} agree={agree} monomials={s.monomials} max_coeff={s.max_coeff} r_groups={s.r_groups}"
        if agree != "1":
            print of "FAIL: full-sample build disagrees with brute force"
            exit of 1
        return 0
    if (len of argv) > 0 and argv[0] == "thr2-sweep":
        local seed is 1
        if (len of argv) > 1:
            seed is num of argv[1]
        # (a) sampling error vs s_bot at n=10 (rounding bias makes this
        # NON-monotone — that is the finding, not a bug)
        local c is gen_thr2 of [10, 4, 5, seed]
        for sb in [3, 4, 5]:
            local tot is 0
            for sd in [1, 2, 3, 4, 5]:
                tot is tot + (t2_single of [c, sb, 4, sd]).mismatches
            print of f"thr2 error s_bot={sb} mean_mismatches={tot / 5} of 1024"
        # (b) composed support vs the 2^(n/2) budget as the circuit grows
        for m in [4, 6, 8]:
            local cm is gen_thr2 of [14, m, 5, seed]
            local sm is t2_single of [cm, 5, m, 7]
            local bm is brute_thr2 of cm
            local agree is "0"
            if sm.count == bm and sm.mismatches == 0:
                agree is "1"
            print of f"thr2 support n=14 m={m} monomials={sm.monomials} budget=2^7=128 max_coeff={sm.max_coeff} r_groups={sm.r_groups} agree={agree}"
            if agree != "1":
                print of "FAIL: sweep row disagrees with brute force"
                exit of 1
        return 0
    local n is 12
    local m_count is 60
    local seed is 1
    local k is 15
    if (len of argv) > 0:
        n is num of argv[0]
    if (len of argv) > 1:
        m_count is num of argv[1]
    if (len of argv) > 2:
        seed is num of argv[2]
    if (len of argv) > 3:
        k is num of argv[3]
    else:
        k is floor of (m_count / 4)

    local monomials is gen_monomials of [n, m_count, seed]
    local table is gen_threshold_table of [m_count, k]

    local t0 is clock_unix of null
    local engine is symplus_counts of [n, monomials]
    local t1 is clock_unix of null
    local oracle is brute_counts of [n, monomials]
    local t2 is clock_unix of null

    local agree is counts_equal of [engine, oracle]
    local sat_engine is sym_sat_count of [engine, table]
    local sat_oracle is sym_sat_count of [oracle, table]
    local engine_ms is floor of ((t1 - t0) * 1000)
    local brute_ms is floor of ((t2 - t1) * 1000)

    print of f"symplus n={n} m={m_count} seed={seed} k={k} agree={agree} sat={sat_engine} sat_oracle={sat_oracle} engine_ms={engine_ms} brute_ms={brute_ms}"
    if agree != 1:
        print of "FAIL: engine disagrees with brute-force oracle"
        exit of 1
    if sat_engine != sat_oracle:
        print of "FAIL: sat counts disagree"
        exit of 1

main of null
